{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{server,shared}/**",
      "excludeFiles": "{server/tests/**,dist/**,.env*}"
    }
  },
  "routes": [
    {
      "src": "/api(?:/.*)?",
      "dest": "/api/index.js"
    },
    {
      "src": "/privacy(?:-policy)?/?",
      "dest": "/privacy.html"
    },
    {
      "src": "/terms(?:-of-service)?/?",
      "dest": "/terms.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
