# FRONTEND — these two values are public and are included in the Vite build.
# true = clearly labelled browser-only demo; false = use the real Express API.
VITE_DEMO_MODE=true
VITE_API_URL=/api

# SERVER — never put server secrets in variables beginning with VITE_.
# Optional override. Leave blank for development; npm start sets production.
NODE_ENV=
API_PORT=4000
# Most Node hosts supply PORT automatically; it takes precedence over API_PORT.
PORT=
CLIENT_URL=http://localhost:4173
MONGODB_URI=
JWT_SECRET=
# lax works with same-origin hosting; none is only for HTTPS cross-site hosting.
COOKIE_SAME_SITE=lax
TRUST_PROXY=0

# PAYSTACK — server-side only. Use sk_test_... until merchant setup is complete.
# USD must be enabled on your merchant account.
PAYSTACK_SECRET_KEY=

# AI — an OpenAI-compatible chat completions API.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini

# EMAIL — optional until password reset is needed.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Used by npm run admin:invite if no email argument is provided.
INITIAL_ADMIN_EMAIL=
